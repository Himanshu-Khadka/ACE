# copy this to .env and fill it in. .env is gitignored, never commit your token

# the canvas you log into
CANVAS_BASE_URL=https://canvas.ualberta.ca
# Canvas > Account > Settings > + New Access Token
CANVAS_TOKEN=paste-your-token-here

# how often to check canvas (go duration: 15m, 1h, ...)
SYNC_INTERVAL=30m
# "due soon" alerts for unfinished work due within this long
DUE_SOON=48h
# courses synced at the same time. canvas rate limits, don't go crazy
SYNC_WORKERS=3
# used for dates like 2026-11-20 and all day events
TZ=America/Edmonton

# optional: require this token for the api (Authorization: Bearer <token> or ?token=)
API_TOKEN=
# optional: every sync POSTs new changes here as json
WEBHOOK_URL=

# postgres password (only used inside docker)
POSTGRES_PASSWORD=change-me
